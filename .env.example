# victoriana environment. Copy to .env and set OTLP_TOKEN.
#
#   cp .env.example .env
#   $EDITOR .env

# Bearer token the OTLP collector requires on :4318. Apps present it as
#   Authorization: Bearer <token>
# Generate one with:  openssl rand -hex 32
OTLP_TOKEN=replace-with-a-long-random-secret
# Optional second accepted token, for zero-downtime rotation (see README).
#OTLP_TOKEN_NEXT=

# --- TLS on :4318 (optional) -----------------------------------------------
# none     plain HTTP (default)
# acme     Let's Encrypt, DNS-01 via Cloudflare; needs the three keys below
# byocert  your own cert: put tls.crt + tls.key in ./certs/
# Apply with: docker compose up -d traefik
OTLP_TLS_MODE=none
# acme only: the public hostname the cert is issued for (and the only Host the
# OTLP router answers), the Let's Encrypt account email, and the Cloudflare API
# token (Zone:DNS:Edit) that Traefik uses for the DNS-01 challenge.
OTLP_HOSTNAME=
ACME_EMAIL=
CLOUDFLARE_API_TOKEN=

# --- Grafana exposure (optional) --------------------------------------------
# Host bind for Traefik's `web` entrypoint, which serves the Grafana UI (Grafana
# itself is internal-only and reached through Traefik). Default is loopback
# (SSH tunnel). Expose on the LAN with "0.0.0.0:80", or pin to one interface:
# "10.0.0.5:80". Grafana ships anonymous-Admin (see README) -- only expose on a
# trusted network.
#TRAEFIK_WEB_BIND=127.0.0.1:80

# --- Optional image pins (defaults are baked into docker-compose.yml) --------
#TRAEFIK_VERSION=v3.6.17
#VM_VERSION=v1.142.0
#VL_VERSION=v1.50.0
#VT_VERSION=v0.8.2
#VMALERT_VERSION=v1.142.0
#GRAFANA_VERSION=11.4.0
#OTELCOL_VERSION=0.151.0
#VL_PLUGIN_VERSION=0.33.1    # victoriametrics-logs-datasource Grafana plugin

# --- Optional collector memory limit (default 512m) ------------------------
# The collector's memory_limiter refuses data at 80% of this.
#OTELCOL_MEM_LIMIT=512m

# --- Optional retention (defaults 30d/30d/7d) -------------------------------
# VictoriaMetrics duration syntax: 1d, 30d, 1y, ...
#VM_RETENTION_PERIOD=30d
#VL_RETENTION_PERIOD=30d
#VT_RETENTION_PERIOD=7d

# --- Optional disk guards (all three stores share ./data's filesystem) -------
# VictoriaLogs/Traces delete their oldest days once the filesystem is this full:
#VL_MAX_DISK_USAGE_PERCENT=80
#VT_MAX_DISK_USAGE_PERCENT=80
# Every store refuses new data below this much free space (metrics are never
# deleted early, so this is VictoriaMetrics' only guard):
#VM_MIN_FREE_DISK=1GiB
#VL_MIN_FREE_DISK=1GiB
#VT_MIN_FREE_DISK=1GiB
