# Secrets + local overrides
.env

# Runtime data (bind mounts: VM/VL/VT storage, ACME acme.json)
/data/

# Bring-your-own-cert material
/certs/*.crt
/certs/*.key
/certs/*.pem

# Consumer drop-ins: each consumer owns its own subdirectory, out-of-band
/grafana/dashboards/*/
/vmalert/rules/*/
# ...except victoriana's own self-monitoring
!/grafana/dashboards/victoriana/
!/vmalert/rules/victoriana/

# Scratch / working notes
/tmp/
