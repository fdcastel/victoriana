{
  "uid": "victoriana-overview",
  "title": "victoriana — stack overview",
  "tags": [
    "victoriana"
  ],
  "description": "Is victoriana healthy? Edge, collector, stores. Deep-dive dashboards per component: see the README (Self-monitoring).",
  "timezone": "",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Components up (scrape health)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 19,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "description": "One row per scrape job (victoriametrics/scrape.yml). Red = scrape failing."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "TLS cert expires in",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "min(traefik_tls_certs_not_after) - time()",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1209600
              },
              {
                "color": "green",
                "value": 2592000
              }
            ]
          },
          "unit": "dtdurations"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Earliest-expiring certificate Traefik serves. Empty with OTLP_TLS_MODE=none. Let's Encrypt renews at 30 days left."
    },
    {
      "id": 5,
      "type": "row",
      "title": "OTLP edge (Traefik :4318)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (code) (rate(traefik_service_requests_total{service=\"otlp@file\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "200 = accepted, 401 = bad/missing token, 429/503 = collector refusing or unhealthy. Requests not matching the router (e.g. scanners by IP in acme mode) never reach this service."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Accepted by the collector",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points[$__rate_interval]))",
          "legendFormat": "metric points"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_log_records[$__rate_interval]))",
          "legendFormat": "log records"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_spans[$__rate_interval]))",
          "legendFormat": "spans"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Items per second the OTLP receiver accepted, per signal."
    },
    {
      "id": 8,
      "type": "row",
      "title": "Pipeline problems",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Refused / failed / dropped",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (__name__) (rate({__name__=~\"otelcol_receiver_refused_.+\"}[$__rate_interval]) keep_metric_names)",
          "legendFormat": "refused: {{__name__}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (__name__) (rate({__name__=~\"otelcol_receiver_failed_.+\"}[$__rate_interval]) keep_metric_names)",
          "legendFormat": "failed: {{__name__}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (exporter) (rate({__name__=~\"otelcol_exporter_send_failed_.+\"}[$__rate_interval])) or sum by (exporter) (otelcol_exporter_queue_capacity) * 0",
          "legendFormat": "export failed: {{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Should stay at 0. refused = memory_limiter backpressure or a full export queue (producers retry); failed = the receiver could not hand data on; export failed = a store rejected data permanently and it was dropped (send_failed only exists after the first failure, hence the explicit 0)."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Export queue fill",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (exporter) (otelcol_exporter_queue_size / otelcol_exporter_queue_capacity)",
          "legendFormat": "{{exporter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The collector's on-disk export queue per store: batches waiting while a store is down or slow, drained when it is back (nothing is dropped). Batches already being retried (up to 10 per store) are not counted, so a short outage on a quiet stack can read 0. At 100% the collector refuses new data."
    },
    {
      "id": 10,
      "type": "row",
      "title": "Storage",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Rows stored per second",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(vm_rows_inserted_total[$__rate_interval]))",
          "legendFormat": "victoriametrics"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(vl_rows_ingested_total[$__rate_interval]))",
          "legendFormat": "victorialogs"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(vt_rows_ingested_total[$__rate_interval]))",
          "legendFormat": "victoriatraces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Includes self-monitoring scrapes in victoriametrics."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Data on disk",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (job) ({__name__=~\"(vm|vl|vt)_data_size_bytes\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Free disk (./data filesystem)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 26,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "min({__name__=~\"(vm|vl|vt)_free_disk_space_bytes\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 5368709120
              },
              {
                "color": "green",
                "value": 21474836480
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "All three stores share this filesystem. VictoriaLogs/Traces drop their oldest days once their own data passes VL_MAX_DISK_USAGE/VT_MAX_DISK_USAGE; every store stops ingesting below 1 GiB free."
    }
  ]
}
